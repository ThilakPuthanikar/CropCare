# Environment Configuration (development, staging, production)
ENVIRONMENT=development
DEBUG=false
PORT=8000

# URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:3000

# Database Configuration (Neon PostgreSQL format: postgresql+psycopg://user:password@host/dbname?sslmode=require)
DATABASE_URL=


# Security & Authentication Secrets
SECRET_KEY=replace_with_a_long_secure_secret_key_for_production
JWT_SECRET=replace_with_a_long_secure_jwt_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External API Keys
WEATHERSTACK_API_KEY= KEY
GROQ_API_KEY= KEY
CHATBOT_ID= KEY
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Credentials
ADMIN_EMAIL=admin@cropcare.com
ADMIN_PASSWORD= Password
